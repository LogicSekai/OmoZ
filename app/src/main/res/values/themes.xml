<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this theme only sets the window colours before first frame. -->
    <style name="Theme.OmoZ" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/peach</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/orange</item>
    </style>
</resources>
