    <!-- Sounds -->
    <string name="spec_turbine">%1$s · smooth, no gears</string>
    <string name="spec_piston">%1$d gears · redline %2$s rpm</string>
    <string name="sounds_footer">Sounds are synthesized in real time on your phone — no recordings, no internet. Developers can add new engines in the engine-core module (see docs/ADDING_ENGINE_SOUND.md).</string>

    <string name="engine_jet_turbine_name">Jet Turbine</string>
    <string name="engine_jet_turbine_desc">Turbofan whine and exhaust roar that spools up slowly with your speed — the most noticeable sound for traffic around you.</string>
    <string name="engine_jet_whine_name">Jet Whine</string>
    <string name="engine_jet_whine_desc">Only the high-pitched turbine “nging” that climbs with your speed — no wind or exhaust roar.</string>
    <string name="engine_jet_hum_name">Jet Hum</string>
    <string name="engine_jet_hum_desc">Only the deep turbine “ngung” hum that rises with your speed — no high whine or wind.</string>
    <string name="engine_bullet_train_motor_name">Bullet Train Motor</string>
    <string name="engine_bullet_train_motor_desc">Electric traction motor of a high-speed train: rising magnetic hum and inverter whine that is loudest while pulling away.</string>
    <string name="engine_v_twin_cruiser_name">V-Twin Cruiser</string>
    <string name="engine_v_twin_cruiser_desc">Deep, lumpy 45° V-twin with the classic uneven idle and a 5-speed virtual gearbox.</string>
    <string name="engine_big_twin_classic_name">Big Twin Classic</string>
    <string name="engine_big_twin_classic_desc">Old-school 1340 cc 45° V-twin: a low, hunting idle, open pipes, valve clatter and a clunky 4-speed with throttle cuts and overrun pops.</string>
    <string name="engine_inline_four_sport_name">Inline-4 Sport</string>
    <string name="engine_inline_four_sport_desc">Smooth superbike that screams to 14,000 rpm through 6 virtual gears, with over-run crackles.</string>
    <string name="engine_inline_four_250_name">Inline-4 250</string>
    <string name="engine_inline_four_250_desc">Quarter-litre inline four that screams all the way to 17,000 rpm, with an intake howl, a hard rev limiter and quick-shifter upshifts through 6 gears.</string>
    <string name="engine_inline_four_400_name">Inline-4 400</string>
    <string name="engine_inline_four_400_desc">400 cc inline four with more body than the 250, screaming to 16,000 rpm with quick-shifter upshifts through 6 gears.</string>
    <string name="engine_inline_four_600_name">Inline-4 600</string>
    <string name="engine_inline_four_600_desc">Middleweight supersport four: a hard-edged howl to 16,000 rpm, overrun pops and crisp quick-shifts.</string>
    <string name="engine_inline_four_1000_name">Inline-4 1000</string>
    <string name="engine_inline_four_1000_desc">Litre superbike four: a deep bark at low rpm, a savage howl to 14,000 rpm and loud pops when you roll off.</string>
    <string name="engine_supercharged_four_1000_name">Supercharged 1000</string>
    <string name="engine_supercharged_four_1000_desc">Supercharged litre four: superbike exhaust plus a supercharger whine that rises with rpm and boost, and a chirp when you roll off.</string>
    <string name="engine_two_stroke_racer_name">2-Stroke Racer</string>
    <string name="engine_two_stroke_racer_desc">Raspy single-cylinder two-stroke with a ring-ding power band — the classic street racer.</string>

